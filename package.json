{
  "name": "xl-blog",
  "version": "1.0.0",
  "private": true,
  "description": "Xmartlabs Blog",
  "author": "Martin Barreto",
  "keywords": [
    "astro",
    "blog"
  ],
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build && node scripts/check-asset-sizes.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "prepare": "husky",
    "format": "prettier --write \"**/*.{js,jsx,mjs,ts,tsx,json,css,scss,astro}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,mjs,ts,tsx,json,css,scss,astro}\"",
    "pre-push": ".husky/pre-push",
    "deploy": "astro build && wrangler deploy"
  },
  "engines": {
    "node": ">=22.23.4"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.10",
    "@astrojs/mdx": "^8.1.6",
    "@astrojs/react": "^7.1.9",
    "@astrojs/sitemap": "^3.7.6",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^7.4.13",
    "lodash": "^4.18.1",
    "mdast-util-to-string": "^4.0.0",
    "prismjs": "^1.30.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "reading-time": "^1.5.0",
    "remark-gfm": "^4.0.1",
    "remark-unwrap-images": "^4.0.1",
    "tailwind-merge": "^3.7.1",
    "tailwindcss": "^4.3.5"
  },
  "lint-staged": {
    "*.{js,jsx,mjs,ts,tsx,astro,json,css,scss}": [
      "prettier --write"
    ]
  },
  "type": "module",
  "devDependencies": {
    "@types/lodash": "^4.17.27",
    "@types/react": "^19.3.1",
    "@types/react-dom": "^19.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.2",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "wrangler": "^4.168.0"
  }
}
