# Postgres connection string. Locally: `docker compose up -d postgres`.
# On Vercel: the Neon integration sets it.
DATABASE_URL=postgres://xlblog:xlblog@localhost:5432/xlblog
# Long random string used to sign auth tokens (e.g. `openssl rand -hex 32`).
PAYLOAD_SECRET=
# Public URL of the site, without a trailing slash. Used for OAuth redirects and live preview.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Google sign-in (Google Cloud OAuth client, "Internal" consent screen).
# Redirect URI: <NEXT_PUBLIC_SERVER_URL>/api/users/oauth/google/callback
# Leave the client id/secret empty to disable Google sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ALLOWED_DOMAIN=xmartlabs.com
# `true` = Google sign-in only: hides the email/password form and refuses password logins.
# Recommended in production once the real admins have signed in with Google. Ignored (with a
# warning) unless Google sign-in is configured, so nobody gets locked out.
DISABLE_PASSWORD_LOGIN=

# Vercel Blob store for new uploads. Without it, uploads are stored on local disk (./media).
BLOB_READ_WRITE_TOKEN=

# Google Tag Manager container id (GTM is only added when set).
NEXT_PUBLIC_GTM_ID=
# URL of the "Let's talk" form shown in an iframe.
NEXT_PUBLIC_FORM_URL=
# Base URL for self-hosted legacy videos (video blocks with a legacy file name). Empty = /images/.
NEXT_PUBLIC_MEDIA_BASE_URL=

# Break-glass admin (password login). Created on startup only when the users table is empty.
FIRST_ADMIN_EMAIL=
FIRST_ADMIN_PASSWORD=

# Integration tests (`npm run test:int`) only: their database, dropped and recreated on every
# run. Default: DATABASE_URL with the database name `xlblog_test`. The name must end in `_test`.
# TEST_DATABASE_URL=

# Host port for the local docker-compose Postgres (default 5432).
# POSTGRES_PORT=5432

# Scheduled publishing: Vercel Cron calls /api/payload-jobs/run/ every 5 minutes (vercel.json)
# and sends `Authorization: Bearer $CRON_SECRET`. Random string, letters and digits only
# (e.g. `openssl rand -hex 32`). Locally: curl -H "Authorization: Bearer $CRON_SECRET" \
#   http://localhost:3000/api/payload-jobs/run/
CRON_SECRET=
