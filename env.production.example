# Copy to .env.<mode> (e.g. .env.development or .env.production) and fill in.
# Google Tag Manager container id (GTM is only added when this is set).
PUBLIC_GTM_ID=
# URL of the "Let's talk" form shown in an iframe.
PUBLIC_FORM_URL=
# Base URL for self-hosted videos (<VideoPlayer name="..." />), e.g. an R2 bucket.
# Leave empty to serve them from /images/.
PUBLIC_MEDIA_BASE_URL=
