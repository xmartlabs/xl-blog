---
import BaseLayout from '../layouts/BaseLayout.astro';
import { HeaderBanner } from './header-banner';
import { BlogList } from './blog-list/blog-list';
import { getCategoryTabs, toCardData, type Post } from '../lib/posts';

interface Props {
  posts: Post[];
  currentPage: number;
  numPages: number;
  /** Category id when listing a single category. */
  category?: string;
  /** Selected filter tab: a category id, 'all', or '' for none. */
  selectedCategory?: string;
}

const {
  posts,
  currentPage,
  numPages,
  category,
  selectedCategory = category ?? 'all',
} = Astro.props;
const categoryTabs = await getCategoryTabs();
---

<BaseLayout>
  <HeaderBanner />
  <BlogList
    client:load
    posts={posts.map(toCardData)}
    pageContext={{ currentPage, numPages, category }}
    selectedCategory={selectedCategory}
    categoryTabs={categoryTabs}
    pathname={Astro.url.pathname}
  />
</BaseLayout>
