---
import type { GetStaticPaths } from 'astro';
import PostListPage from '../../components/PostListPage.astro';
import { getPosts, paginate } from '../../lib/posts';

export const getStaticPaths = (async () => {
  const pages = paginate(await getPosts());
  return pages.slice(1).map((posts, i) => ({
    params: { page: String(i + 2) },
    props: { posts, currentPage: i + 2, numPages: pages.length },
  }));
}) satisfies GetStaticPaths;

const { posts, currentPage, numPages } = Astro.props;
---

<PostListPage posts={posts} currentPage={currentPage} numPages={numPages} />
