---
import type { GetStaticPaths } from 'astro';
import kebabCase from 'lodash/kebabCase.js';

import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPosts, postSlug } from '../../lib/posts';

export const getStaticPaths = (async () => {
  const posts = await getPosts();
  const authorIds = [...new Set(posts.map((post) => post.data.author.id))];
  return authorIds.map((authorId) => ({
    params: { author: kebabCase(authorId) },
    props: {
      authorId,
      posts: posts
        .filter((post) => post.data.author.id === authorId)
        .map((post) => ({ title: post.data.title, slug: postSlug(post) })),
    },
  }));
}) satisfies GetStaticPaths;

const { authorId, posts } = Astro.props;
const header = `${posts.length} post${posts.length === 1 ? '' : 's'} written by "${authorId}"`;
---

<BaseLayout>
  <div class="p-[10rem_16%_5rem]">
    <h1>{header}</h1>
    <ul>
      {posts.map((post) => (
        <li>
          <a href={`/blog/${post.slug}/`}>{post.title}</a>
        </li>
      ))}
    </ul>
    <a href="/">back to home</a>
  </div>
</BaseLayout>
