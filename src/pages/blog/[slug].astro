---
import type { GetStaticPaths } from 'astro';
import { getEntry, render } from 'astro:content';
import readingTime from 'reading-time';

import BaseLayout from '../../layouts/BaseLayout.astro';
import { Category } from '../../components/category';
import { XlProfileLinks } from '../../components/social-element/xl-profile-links';
import { ClockIcon } from '../../components/icons';
import { MoreBlogsSection } from '../../components/more-blogs-section';
import { Tags } from '../../components/tags/tags';
import { PostInteractions } from '../../components/post-interactions/post-interactions';
import { VideoPlayer } from '../../components/video-player';
import { Table } from '../../components/table';
import { Image } from '../../components/image';
import {
  formatPostDate,
  getPosts,
  postSlug,
  toCardData,
} from '../../lib/posts';

export const getStaticPaths = (async () => {
  const posts = await getPosts();
  // Related posts follow file order (oldest file first), like Gatsby's node order did.
  const byFile = [...posts].sort((a, b) =>
    (a.filePath ?? a.id) < (b.filePath ?? b.id) ? -1 : 1
  );
  return posts.map((post) => ({
    params: { slug: postSlug(post) },
    props: {
      post,
      relatedPosts: byFile
        .filter(
          (other) =>
            other.id !== post.id &&
            other.data.category.id === post.data.category.id
        )
        .slice(0, 3)
        .map(toCardData),
    },
  }));
}) satisfies GetStaticPaths;

const { post, relatedPosts } = Astro.props;
const { Content } = await render(post);
const author = await getEntry(post.data.author);
const category = await getEntry(post.data.category);
if (!author)
  throw new Error(
    `Unknown author "${post.data.author.id}" in ${post.filePath}`
  );
if (!category)
  throw new Error(
    `Unknown category "${post.data.category.id}" in ${post.filePath}`
  );

const HERO_FALLBACK_IMAGE = '/images/image.png';
const pathname = Astro.url.pathname;
const timeToRead = readingTime(post.body ?? '').text;
const usesInstagram = (post.body ?? '').includes('instagram-media');
---

<BaseLayout title={post.data.title} image={post.data.thumbnail}>
  {usesInstagram && (
    <script
      slot="head"
      is:inline
      async
      src="https://www.instagram.com/embed.js"
    />
  )}
  <div id="containerDiv">
    <PostInteractions client:load pathname={pathname} />
    <div class="p-[10rem_44%_20rem_16%] bg-blue-six max-lg:p-[10rem_8%_20rem_8%] max-sm:min-h-full max-sm:p-[8rem_1rem_6rem_5%]">
      <div class="flex flex-row items-baseline">
        <Category
          data={category.data.name}
          className="flex justify-center text-[0.8rem] leading-[2rem] font-black text-blue-one bg-neutral-100 mb-4 w-auto px-4 h-[1.8rem] uppercase tracking-[0.1rem] max-sm:w-auto max-sm:px-4 max-sm:h-[1.5rem] max-sm:leading-[1.7rem]"
        />
      </div>
      <h1 class="my-2 mx-0 text-heading-one text-blue-one font-link max-sm:m-0">
        {post.data.title}
      </h1>
      <div class="w-full">
        <div class="flex flex-row mt-8">
          <img
            src={author.data.image}
            alt={author.data.name}
            class="rounded-[10px] mr-8 w-[5.5rem] h-full"
          />
          <div class="flex flex-col items-start justify-between">
            <a
              href={author.data.profile_url}
              class="no-underline font-link font-bold"
            >
              {author.data.name}
            </a>
            <label class="w-auto text-label-bold text-gray-two font-semibold">
              {formatPostDate(post.data.date)}
            </label>
            <label class="w-auto text-label-bold text-gray-two font-semibold">
              <ClockIcon className="mr-[0.5rem] inline" />
              {timeToRead}
            </label>
          </div>
        </div>
      </div>
    </div>
    <img
      src={post.data.thumbnail || HERO_FALLBACK_IMAGE}
      data-fallback={HERO_FALLBACK_IMAGE}
      alt="Blog Main Image"
      class="transform translate-y-[-230px] ml-[16%] mb-20 w-[51.3rem] max-w-[85vh] h-auto max-lg:ml-[8%] max-sm:transform max-sm:-translate-y-12 max-sm:m-0 max-sm:w-full max-sm:h-auto"
    />
    <div class="bodyPostContainer">
      <Content components={{ VideoPlayer, Table, Image }} />
    </div>
    <div class="flex flex-row-reverse justify-start items-baseline p-[5rem_30%_2rem_16%] max-xxl:pr-[30%] max-lg:px-[8%] max-sm:flex-col max-sm:p-0">
      <div class="flex flex-row justify-end max-sm:justify-start">
        <XlProfileLinks className="flex flex-row static items-center w-full z-0 max-sm:w-auto [&_a]:flex [&_a]:items-center [&_a]:m-[0.7rem]" />
      </div>
      <Tags
        blogTags={post.data.tags}
        className="max-sm:w-[90%] max-sm:mt-4 max-sm:ml-4"
      />
    </div>
    <MoreBlogsSection
      relatedPosts={relatedPosts}
      title={category.data.name}
      categoryId={category.id}
    />
  </div>
</BaseLayout>
